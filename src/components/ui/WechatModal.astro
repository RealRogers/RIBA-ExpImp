---
import { wechatId } from '../../data/content';
---
<div id="wcModal" class="hide fixed inset-0 z-50 bg-black/70 grid place-items-center p-4"><div class="relative bg-white rounded-2xl p-8 max-w-xs max-h-[90vh] overflow-y-auto w-full text-center text-slate-700"><button class="x absolute top-3 right-3 text-xl" aria-label="Cerrar">✕</button><p class="font-bold text-ink text-lg">微信 WeChat</p><img src="/images/wechat-qr.png" alt="Código QR de WeChat" class="w-48 h-48 mx-auto my-4"/><p class="font-semibold text-ink">Escanee para contactar por WeChat</p><p class="text-xs mt-1">ID: {wechatId}</p></div></div>
