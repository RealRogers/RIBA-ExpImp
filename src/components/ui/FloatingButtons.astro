---
import { whatsappUrl } from '../../data/content';
import Icon from './Icon.astro';
---
<div class="fixed right-4 bottom-4 z-40 flex flex-col gap-3">
<button id="wcBtn" aria-label="WeChat" class="w-12 h-12 rounded-full bg-emerald-600 text-white shadow-lg text-lg hover:scale-110 transition self-end">微</button>
<a href={whatsappUrl} aria-label="WhatsApp" class="w-14 h-14 rounded-full bg-green-500 text-white shadow-lg grid place-items-center hover:scale-110 transition"><Icon name="whatsapp"/></a></div>
