---
import { whatsappUrl } from '../../data/content';
import Icon from './Icon.astro';

// Mientras whatsappUrl sea el placeholder '#', no abrir pestaña nueva.
const waExt = whatsappUrl.startsWith('https://') ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---
<div class="fixed right-4 bottom-4 z-40 flex flex-col items-end gap-3">
<button id="topBtn" type="button" aria-label="Volver arriba" class="hide w-12 h-12 rounded-full bg-ink text-white shadow-lg grid place-items-center hover:scale-110 transition"><Icon name="up"/></button>
<a href={whatsappUrl} {...waExt} aria-label="Contactar por WhatsApp" class="w-14 h-14 rounded-full bg-green-500 text-white shadow-lg grid place-items-center hover:scale-110 transition"><Icon name="whatsapp"/></a>
</div>

<script>
const topBtn = document.getElementById('topBtn')!;
const onScroll = () => topBtn.classList.toggle('hide', scrollY < 400);
addEventListener('scroll', onScroll, { passive: true });
onScroll();
topBtn.onclick = () => scrollTo({ top: 0, behavior: 'smooth' });
</script>
