---
import { whatsappUrl } from '../../data/content';
import Icon from './Icon.astro';

// Mientras whatsappUrl sea el placeholder '#', no abrir pestaña nueva.
const waExt = whatsappUrl.startsWith('https://') ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---
<a href={whatsappUrl} {...waExt} aria-label="Contactar por WhatsApp" class="fixed right-4 bottom-4 z-40 w-14 h-14 rounded-full bg-green-500 text-white shadow-lg grid place-items-center hover:scale-110 transition"><Icon name="whatsapp"/></a>
