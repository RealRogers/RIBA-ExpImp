---
import { whyItems } from '../../data/content';
import Icon from '../ui/Icon.astro';
---
<section class="py-14 bg-white"><div class="max-w-6xl mx-auto px-4"><p class="kick text-amber-700">Nuestra garantía</p><h2 class="h mt-2 text-3xl md:text-4xl text-ink">¿Por qué con nosotros?</h2><div class="mt-8 grid md:grid-cols-2 gap-4">
{whyItems.map((w, i) => <div class="box flex gap-4"><div class="shrink-0 flex flex-col items-center gap-3"><span class="h text-3xl text-brand">0{i + 1}</span><span class="grid place-items-center w-10 h-10 rounded-full bg-ink text-amber-400"><Icon name={w.icon} class="w-5 h-5"/></span></div><div><h3 class="font-bold text-ink">{w.title}</h3><p class="text-sm mt-1 text-slate-600">{w.desc}</p></div></div>)}
</div></div></section>
