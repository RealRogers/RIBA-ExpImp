---
import { heroImage } from '../../data/content';
---
<section class="relative overflow-hidden bg-deep">
<div class="absolute inset-0 bg-[linear-gradient(130deg,#0A2438_20%,#0B2D4A_65%)]"></div>
<img src={heroImage} alt="" loading="eager" class="absolute inset-0 w-full h-full object-cover" onerror="this.remove()"/>
<div class="absolute inset-0 bg-[linear-gradient(100deg,rgba(10,36,56,.95)_25%,rgba(11,45,74,.75)_55%,rgba(11,45,74,.35))]"></div>
<div class="relative max-w-6xl mx-auto px-4 py-16 md:py-24 grid lg:grid-cols-2 gap-10 lg:gap-14 items-center">
<div>
<p class="kick text-amber-400">Corredor China ⇄ México</p>
<h1 class="h mt-4 text-4xl md:text-5xl xl:text-6xl leading-[1.05] text-white">Su maquinaria, de la fábrica en China a su bodega, sin sorpresas.</h1>
<p class="mt-5 text-lg md:text-xl text-slate-200">Seguridad aduanal, inspección en fábrica y logística puerta a puerta (DDP). Operaciones blindadas para la industria.</p>
<div class="mt-8 flex flex-col sm:flex-row gap-3"><a href="/importacion" class="btn cta">Importar de China</a><a href="/exportacion" class="btn ghost">Exportar a China</a></div>
<div class="mt-10 flex flex-wrap gap-x-6 gap-y-2 text-sm font-semibold text-slate-200"><span>+500 Contenedores</span><span class="text-amber-400/50 hidden sm:inline">·</span><span>Padrón de Importadores Activo</span><span class="text-amber-400/50 hidden sm:inline">·</span><span>Inspección In-Situ en China</span></div>
</div>
<div><div class="rounded-2xl bg-deep/80 backdrop-blur border border-white/10 p-3 shadow-2xl"><svg viewBox="0 0 400 260" class="w-full" role="img" aria-label="Ruta marítima de Ningbo a Manzanillo por el Pacífico">
<g stroke="#fff" stroke-opacity=".05"><path d="M0 65H400M0 130H400M0 195H400M100 0V260M200 0V260M300 0V260"/></g>
<path d="M0 40 L40 28 L78 52 L92 96 L70 128 L84 160 L58 196 L30 190 L0 210Z" fill="#fff" fill-opacity=".07"/>
<path d="M400 30 L352 36 L318 74 L330 120 L312 150 L338 172 L322 196 L352 214 L400 230Z" fill="#fff" fill-opacity=".07"/>
<path id="r" class="dash" d="M92 100 C 150 40, 250 40, 322 165" fill="none" stroke="#F59E0B" stroke-width="2.5" stroke-linecap="round"/>
<circle r="5" fill="#fff"><animateMotion dur="7s" repeatCount="indefinite"><mpath href="#r"/></animateMotion></circle>
<circle cx="92" cy="100" r="7" fill="#F59E0B"/><circle cx="322" cy="165" r="7" fill="#F59E0B"/>
<text x="92" y="124" fill="#cbd5e1" font-size="12" text-anchor="middle" font-weight="600">Ningbo · Shanghai</text>
<text x="322" y="190" fill="#cbd5e1" font-size="12" text-anchor="middle" font-weight="600">Manzanillo</text>
<text x="205" y="150" fill="#cbd5e1" font-size="11" text-anchor="middle" letter-spacing="3">OCÉANO PACÍFICO</text>
<text x="200" y="245" fill="#cbd5e1" font-size="10" text-anchor="middle">Tránsito marítimo promedio: 30–45 días</text></svg></div></div>
</div></section>
