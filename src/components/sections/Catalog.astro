---
import { machines } from '../../data/content';
import Icon from '../ui/Icon.astro';
---
<section id="maquinaria" class="py-14"><div class="max-w-6xl mx-auto px-4"><p class="kick">Catálogo</p><h2 class="h mt-2 text-3xl md:text-4xl">Maquinaria Industrial</h2><p class="mt-2">Equipos adaptados al voltaje y normativa mexicana.</p><div class="mt-8 grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-4">
{machines.map(m => <article class="box p-0! overflow-hidden flex flex-col"><div class="relative aspect-[3/2] overflow-hidden"><div class="absolute inset-0 grid place-items-center bg-[radial-gradient(circle_at_30%_20%,#1e3a6e,#0B132B)] text-slate-500"><Icon name="gear" class="w-16 h-16"/></div><img src={m.image} alt={m.name} loading="lazy" class="relative w-full h-full object-cover" onerror="this.remove()"/></div><div class="p-3 sm:p-4 flex flex-col gap-2 sm:gap-3 flex-1"><h3 class="h text-base sm:text-lg leading-tight">{m.name}</h3><span class="text-xs font-semibold bg-amber-500/15 text-amber-300 rounded-full px-2 py-1 w-fit">⚡ {m.voltage} · México</span><p class="text-xs sm:text-sm">Tránsito: {m.transit}</p><a href="#cotizar" class="btn ghost text-xs sm:text-sm px-2! mt-auto text-center">Solicitar Ficha Técnica</a></div></article>)}
</div></div></section>
