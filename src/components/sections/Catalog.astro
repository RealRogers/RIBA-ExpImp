---
import { machines } from '../../data/content';
import Icon from '../ui/Icon.astro';

interface Props {
  /** Cuántas tarjetas mostrar (vista rápida en home). Sin límite = catálogo completo. */
  limit?: number;
  /** Si existe, muestra botón hacia el catálogo completo. */
  fullHref?: string;
}

const { limit, fullHref } = Astro.props;
const list = limit ? machines.slice(0, limit) : machines;
---
<section id="maquinaria" class="py-14 bg-mist"><div class="max-w-6xl mx-auto px-4"><p class="kick text-amber-700">Catálogo</p><h2 class="h mt-2 text-3xl md:text-4xl text-ink">Maquinaria Industrial</h2><p class="mt-2 text-slate-600">Equipos adaptados al voltaje y normativa mexicana.</p><p class="mt-1 text-xs text-slate-500">*Tiempos estimados en modalidad Puerta a Puerta (DDP).</p><div class="mt-8 grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-4">
{list.map(m => <article class="box p-0! overflow-hidden flex flex-col"><div class="relative aspect-[3/2] overflow-hidden"><div class="absolute inset-0 grid place-items-center bg-[radial-gradient(circle_at_30%_20%,#123C63,#0B2D4A)] text-slate-500"><Icon name="gear" class="w-16 h-16"/></div><img src={m.image} alt={m.name} loading="lazy" class="relative w-full h-full object-cover" onerror="this.remove()"/></div><div class="p-3 sm:p-4 flex flex-col gap-2 sm:gap-3 flex-1"><h3 class="h text-base sm:text-lg leading-tight text-ink">{m.name}</h3><span class="text-xs font-semibold bg-amber-500/15 text-amber-700 rounded-full px-2 py-1 w-fit">⚡ {m.voltage}<span class="hidden sm:inline"> · México</span></span><p class="text-xs sm:text-sm text-slate-600">Tránsito: {m.transit}</p><a href="/cotizar" class="btn ghostl text-xs sm:text-sm px-2! mt-auto text-center">Solicitar Ficha Técnica</a></div></article>)}
</div>
{fullHref && <div class="mt-8 text-center"><a href={fullHref} class="btn ghostl">Explorar catálogo completo ({machines.length} máquinas) →</a></div>}
</div></section>
