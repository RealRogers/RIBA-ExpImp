---
import { faqs } from '../../data/content';
---
<section class="py-14 bg-deep"><div class="max-w-3xl mx-auto px-4"><p class="kick">Dudas</p><h2 class="h mt-2 text-3xl md:text-4xl">Preguntas frecuentes</h2><div id="faq" class="mt-8 space-y-3">
{faqs.map((f, i) => <div class="box p-0!"><button class="w-full flex justify-between gap-3 p-4 text-left font-semibold text-white">{f.q}<span>▾</span></button><p class:list={['px-4 pb-4', { hide: i > 0 }]}>{f.a}</p></div>)}
</div></div></section>

<script>
document.querySelectorAll('#faq button').forEach(b =>
  (b as HTMLElement).onclick = () => b.nextElementSibling!.classList.toggle('hide')
);
</script>
