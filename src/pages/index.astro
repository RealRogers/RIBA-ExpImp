---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import Services from '../components/sections/Services.astro';
import Catalog from '../components/sections/Catalog.astro';
import RouteBand from '../components/sections/RouteBand.astro';
import Carriers from '../components/sections/Carriers.astro';
import RfqForm from '../components/sections/RfqForm.astro';
---
<Layout>
<Header/>
<main>
<Hero/>
<Services/>
<Catalog limit={4} fullHref="/maquinaria"/>
<RouteBand/>
<Carriers/>
<RfqForm/>
</main>
<Footer/>
</Layout>
