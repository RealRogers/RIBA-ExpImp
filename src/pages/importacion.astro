---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import WhyUs from '../components/sections/WhyUs.astro';
import Process from '../components/sections/Process.astro';
import { importSteps } from '../data/content';
---
<Layout title="Importación de China a México | RIBA" description="Importación integral China → México: auditoría en Shenzhen, fletes FCL/LCL, padrón de importadores, despacho aduanal y entrega DDP puerta a puerta.">
<Header/>
<main>
<section class="py-14 md:py-20 bg-white"><div class="max-w-6xl mx-auto px-4">
<p class="kick text-amber-700">China → México</p>
<h1 class="h mt-2 text-4xl md:text-5xl text-ink">Importación integral, de fábrica a su bodega</h1>
<p class="mt-4 text-lg text-slate-600 max-w-2xl">Acompañamiento completo en cada etapa: verificamos al proveedor, supervisamos la producción y resolvemos la aduana. Usted recibe su carga, nosotros nos encargamos del resto.</p>
<a href="/cotizar" class="btn cta mt-6">Cotizar importación →</a>
</div></section>
<section class="py-14 bg-mist"><div class="max-w-6xl mx-auto px-4">
<p class="kick text-amber-700">Paso a paso</p>
<h2 class="h mt-2 text-3xl md:text-4xl text-ink">Cómo funciona el servicio</h2>
<div class="mt-8 grid md:grid-cols-2 lg:grid-cols-3 gap-4">
{importSteps.map((s, i) => <div class="box"><span class="h text-2xl text-brand">0{i + 1}</span><h3 class="font-bold text-ink mt-2">{s.title}</h3><p class="text-sm mt-1 text-slate-600">{s.desc}</p></div>)}
</div></div></section>
<WhyUs/>
<Process/>
<section class="py-14 bg-ink"><div class="max-w-3xl mx-auto px-4 text-center">
<h2 class="h text-3xl md:text-4xl text-white">¿Listo para su primera importación?</h2>
<p class="mt-3 text-slate-300">Reciba una cotización detallada con costos, tiempos y requisitos para su operación.</p>
<a href="/cotizar" class="btn cta mt-6">Solicitar cotización →</a>
</div></section>
</main>
<Footer/>
</Layout>
