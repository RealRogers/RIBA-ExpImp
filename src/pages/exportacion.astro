---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { exportPoints, exportServices } from '../data/content';
import Icon from '../components/ui/Icon.astro';
---
<Layout title="Exportación de México a China | RIBA" description="Exportación México → China: normativas fitosanitarias, Feria de Cantón, empaque certificado y logística de salida con documentación completa.">
<Header/>
<main>
<section class="py-14 md:py-20 bg-white"><div class="max-w-6xl mx-auto px-4">
<p class="kick text-amber-700">México → China</p>
<h1 class="h mt-2 text-4xl md:text-5xl text-ink">Su producto mexicano, en el mercado asiático</h1>
<p class="mt-4 text-lg text-slate-600 max-w-2xl">Exportar a China exige cumplimiento riguroso de normativas y presencia comercial estratégica. Nosotros lo resolvemos: documentación, certificaciones y enlace con compradores reales.</p>
<a href="/cotizar" class="btn cta mt-6">Cotizar exportación →</a>
</div></section>
<section class="py-14 bg-mist"><div class="max-w-6xl mx-auto px-4">
<p class="kick text-amber-700">Cobertura</p>
<h2 class="h mt-2 text-3xl md:text-4xl text-ink">Qué incluye el servicio</h2>
<div class="mt-8 grid md:grid-cols-2 gap-4">
{exportPoints.map((p, i) => <div class="box flex gap-4"><span class="h text-2xl text-brand shrink-0">0{i + 1}</span><div><h3 class="font-bold text-ink">{p.title}</h3><p class="text-sm mt-1 text-slate-600">{p.desc}</p></div></div>)}
</div>
<div class="box mt-6"><p class="font-semibold text-ink">Alcance operativo</p><ul class="mt-3 grid sm:grid-cols-2 gap-2.5 text-sm text-slate-600">{exportServices.map(s => <li class="flex gap-2"><span class="text-ink shrink-0 mt-0.5"><Icon name="check" class="w-4 h-4"/></span>{s}</li>)}</ul></div>
</div></section>
<section class="py-14 bg-ink"><div class="max-w-3xl mx-auto px-4 text-center">
<h2 class="h text-3xl md:text-4xl text-white">Abra su operación hacia Asia</h2>
<p class="mt-3 text-slate-300">Evaluamos la viabilidad de su producto en el mercado chino y le presentamos un plan de exportación.</p>
<a href="/cotizar" class="btn cta mt-6">Solicitar cotización →</a>
</div></section>
</main>
<Footer/>
</Layout>
