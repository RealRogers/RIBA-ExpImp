---
import '../styles/global.css';
import FloatingButtons from '../components/ui/FloatingButtons.astro';
import CreditModal from '../components/ui/CreditModal.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'RIBA | Comercio Exterior China–México',
  description = 'Importación y exportación China ⇄ México: sourcing verificado, inspección en fábrica, aduanas y entrega puerta a puerta DDP.',
} = Astro.props;
---
<!doctype html>
<html lang="es">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/>
<title>{title}</title>
<meta name="description" content={description}/>
<meta property="og:title" content={title}/>
<meta property="og:description" content={description}/>
<meta property="og:type" content="website"/>
<link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap"/>
</head>
<body>
<slot/>
<CreditModal/>
<FloatingButtons/>
<script>
const credit = document.getElementById('credit')!;
credit.onclick = e => {
  const t = e.target as HTMLElement;
  if (t === credit || t.classList.contains('x')) credit.classList.add('hide');
};
document.getElementById('creditBtn')!.onclick = () => credit.classList.remove('hide');
addEventListener('keydown', e => {
  if (e.key === 'Escape') credit.classList.add('hide');
});
</script>
</body>
</html>
